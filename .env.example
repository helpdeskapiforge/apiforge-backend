# Copy this file to .env and adjust values for your environment.
# NEVER commit a real .env file -- it is already covered by .gitignore.

# --- Database ---
DB_URL=jdbc:
DB_USERNAME=
DB_PASSWORD=

# --- JWT ---
# Generate a strong secret with: openssl rand -base64 48
JWT_SECRET=replace-with-a-real-base64-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=

# --- CORS ---
# Comma-separated list of exact origins allowed to call this API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
APP_LOG_LEVEL=INFO

# --- AI Providers ---
# Every value below is optional -- the app boots and every non-AI feature works with
# none of these set. AI Tools resolve the first AVAILABLE provider in this order
# (override with AI_PROVIDER_PRIORITY): ollama > lmstudio > openrouter > gemini.
# See README.md > "AI Providers" for setup instructions for each.
AI_PROVIDER_PRIORITY=ollama,lmstudio,openrouter,gemini

# Local Ollama (https://ollama.com) -- free, no key needed, nothing leaves your machine.
# Running the whole stack via `docker compose up`? Leave these two as-is -- docker-compose.yml
# already points OLLAMA_BASE_URL at the bundled `ollama` container and auto-pulls this model
# for you. Only running the backend bare (mvnw/java -jar) with Ollama installed on your host?
# Then http://localhost:11434 is correct as-is too, as long as you've run `ollama pull gemma3`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# Local LM Studio (https://lmstudio.ai) -- free, no key needed.
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model

# OpenRouter (https://openrouter.ai/keys) -- free tier, requires a key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Gemini (https://aistudio.google.com/app/apikey) -- free tier, requires a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

